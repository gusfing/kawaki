    "build": "node scripts/build-blog.js && node scripts/build-for-vercel.js",
    "vercel-build": "node scripts/build-blog.js && node scripts/build-for-vercel.js",
    "lint": "eslint"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "tailwindcss": "^4",
    "typescript": "^5"
