{
  "name": "kawaki-studios",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/start-all.js",
    "dev:all": "node scripts/start-all.js",
    "start": "node scripts/start-all.js",
    "backend": "cd admin-dashboard/backend && npx tsx src/index.ts",
