{
  "manifest_version": 3,
  "name": "Kawaki Agent Chrome Bridge",
  "version": "2.0.0",
  "description": "Lets the local Kawaki agent bridge (127.0.0.1:8765) read and drive your Chrome tabs. Only the token-protected local server can send commands.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "tabs", "activeTab", "storage", "alarms", "debugger"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Kawaki Agent Chrome Bridge" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
