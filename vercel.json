{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/((?!assets/|.*\\..*).*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/blog-post",
      "destination": "/api/legacy-blog-redirect"
    },
    {
      "source": "/cli",
      "destination": "/api/cli"
    },
    {
      "source": "/term",
      "destination": "/api/cli"
    }
  ],
